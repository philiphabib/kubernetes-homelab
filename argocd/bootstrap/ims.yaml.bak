apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: ims
  namespace: argocd

spec:
  project: default

  source:
    repoURL: https://github.com/philiphabib/ims-gitops.git
    targetRevision: main
    path: .
    helm:
      releaseName: ims

  destination:
    server: https://kubernetes.default.svc
    namespace: open5gs

  syncPolicy:
    automated:
      prune: true
      selfHeal: true

    syncOptions:
      - CreateNamespace=true
